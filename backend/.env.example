PORT=5000
NODE_ENV=development
# If running via Docker, 127.0.0.1 refers to the container itself, not your
# host machine - use a MongoDB Atlas URI (recommended, works from anywhere),
# or mongodb://host.docker.internal:27017/... to reach a Mongo running on
# your host.
MONGO_URI=mongodb://127.0.0.1:27017/service_provider_portal
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional: powers the AI-assisted features (admin summaries, rejection drafts,
# category suggestions, document verification). Leave unset to disable them.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: powers "Sign in with Google". Create one at
# https://console.cloud.google.com/ (APIs & Services > Credentials > OAuth
# client ID > Web application), with http://localhost:5173 as an authorized
# JavaScript origin. Leave unset to disable Google sign-in.
GOOGLE_CLIENT_ID=

# Optional: powers email notifications (application submitted, approved,
# rejected). Uses SendGrid's HTTP API, so it isn't affected by hosts that
# block outbound SMTP ports - safe to use once deployed. Leave unset to
# disable emails; everything else works the same without them.
# 1. Create a free account at https://sendgrid.com
# 2. Settings > Sender Authentication > verify a Single Sender (the address
#    you'll send from - just click the confirmation email it sends you)
# 3. Settings > API Keys > create a key with "Mail Send" access
SENDGRID_API_KEY=
EMAIL_FROM=
